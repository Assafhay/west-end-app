rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users — own data only ──────────────────────────────────
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Shows collection — public read-only ───────────────────
    match /shows/{showId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Blog posts ────────────────────────────────────────────
    // Anyone can read published posts.
    // Only the admin UID can write (create / update / delete).
    // Replace YOUR_ADMIN_UID with the actual Firebase UID from
    // Firebase Console → Authentication → Users.
    match /posts/{postId} {
      allow read: if resource.data.published == true;
      allow write: if request.auth != null
                   && request.auth.uid == "YOUR_ADMIN_UID";
    }

    // ── Quiz results — per-user ───────────────────────────────
    match /quizResults/{docId} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
